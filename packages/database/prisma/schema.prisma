generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum ApplicationStatus {
	DISCOVERED
	MATCHED
	ELIGIBLE
	SKIPPED
	QUEUED
	PREPARING
	READY_FOR_REVIEW
	APPLYING
	READY_TO_SUBMIT
	SUBMITTED
	FAILED
	MANUAL_REVIEW
	MOCK_SUBMITTED
}

enum AutomationMode {
	REVIEW
	HYBRID
	AUTO
}

model User {
	id           String            @id @default(cuid())
	email        String            @unique
	passwordHash String
	createdAt    DateTime          @default(now())
	profile      CandidateProfile?
	preferences  UserPreferences?
	resumes      Resume[]
	answers      Answer[]
	applications Application[]
	runs         AutomationRun[]
}

model CandidateProfile {
	id              String   @id @default(cuid())
	userId          String   @unique
	fullName        String
	location        String
	skills          Json
	titles          Json
	yearsExperience Int
	workAuthorized  Boolean?
	phone           String?
	user            User     @relation(fields: [userId], references: [id])
}

model UserPreferences {
	id                   String         @id @default(cuid())
	userId               String         @unique
	targetRoles          Json
	locations            Json
	employmentTypes      Json
	remotePreference     String         @default("REMOTE_OR_HYBRID")
	minSalary            Int?
	maxSalary            Int?
	mode                 AutomationMode @default(REVIEW)
	minimumScore         Int            @default(70)
	autoApplyThreshold   Int            @default(85)
	maxApplicationsPerRun Int          @default(20)
	maxApplicationsPerDay Int          @default(50)
	automationEnabled    Boolean        @default(false)
	autoApplyEnabled     Boolean        @default(false)
	user                 User           @relation(fields: [userId], references: [id])
}

model Resume {
	id            String        @id @default(cuid())
	userId        String
	filename      String
	storageKey    String
	extractedText String?
	createdAt     DateTime      @default(now())
	user          User          @relation(fields: [userId], references: [id])
	applications  Application[]
}

model Job {
	id            String        @id @default(cuid())
	source        String
	sourceJobId   String?
	company       String
	title         String
	location      String
	remote        Boolean       @default(false)
	description   String
	requirements  Json
	jobHash       String        @unique
	applicationUrl String
	postedAt      DateTime?
	createdAt     DateTime      @default(now())
	applications  Application[]
}

model Application {
	id                    String                @id @default(cuid())
	userId                String
	jobId                 String
	resumeId              String?
	status                ApplicationStatus
	matchScore            Int
	eligibility           String
	automationConfidence  Int?
	result                Json?
	createdAt             DateTime              @default(now())
	updatedAt             DateTime              @updatedAt
	user                  User                  @relation(fields: [userId], references: [id])
	job                   Job                   @relation(fields: [jobId], references: [id])
	resume                Resume?               @relation(fields: [resumeId], references: [id])
	transitions           ApplicationTransition[]
	@@unique([userId, jobId])
}

model ApplicationTransition {
	id            String            @id @default(cuid())
	applicationId String
	fromStatus    ApplicationStatus?
	toStatus      ApplicationStatus
	reason        String?
	createdAt     DateTime          @default(now())
	application   Application       @relation(fields: [applicationId], references: [id])
}

model Answer {
	id         String   @id @default(cuid())
	userId     String
	question   String
	answer     String
	category   String
	verified   Boolean  @default(false)
	createdAt  DateTime @default(now())
	user       User     @relation(fields: [userId], references: [id])
}

model AutomationRun {
	id         String    @id @default(cuid())
	userId     String?
	status     String
	createdAt  DateTime  @default(now())
	finishedAt DateTime?
	result     Json?
	user       User?     @relation(fields: [userId], references: [id])
}
