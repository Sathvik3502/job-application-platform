generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum ApplicationStatus { DISCOVERED MATCHED ELIGIBLE SKIPPED QUEUED PREPARING READY_FOR_REVIEW APPLYING READY_TO_SUBMIT SUBMITTED FAILED MANUAL_REVIEW MOCK_SUBMITTED }
enum ApplicationMode { REVIEW HYBRID AUTO }
model User { id String @id @default(cuid()) email String @unique passwordHash String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt profile CandidateProfile? preferences Preference? applications Application[] answers Answer[] resumes Resume[] }
model CandidateProfile { id String @id @default(cuid()) userId String @unique firstName String? lastName String? fullName String location String country String? phone String? linkedin String? portfolio String? skills Json titles Json yearsExperience Int workAuthorized Boolean? sponsorshipRequired Boolean? user User @relation(fields:[userId],references:[id]) }
model Preference { id String @id @default(cuid()) userId String @unique targetRoles Json locations Json remotePreference String @default("REMOTE_OR_HYBRID") minSalary Int? maxSalary Int? employmentTypes Json mode ApplicationMode @default(REVIEW) minimumScore Int @default(70) autoApplyThreshold Int @default(85) maxApplicationsPerRun Int @default(20) maxApplicationsPerDay Int @default(50) automationEnabled Boolean @default(false) autoApplyEnabled Boolean @default(false) user User @relation(fields:[userId],references:[id]) }
model Job { id String @id @default(cuid()) source String sourceJobId String? company String title String location String remote Boolean @default(false) description String requirements Json jobHash String @unique applicationUrl String postedAt DateTime? createdAt DateTime @default(now()) applications Application[] }
model Application { id String @id @default(cuid()) userId String jobId String status ApplicationStatus matchScore Int eligibility String automationConfidence Int? result Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id]) job Job @relation(fields:[jobId],references:[id]) transitions ApplicationTransition[] @@unique([userId,jobId]) }
model ApplicationTransition { id String @id @default(cuid()) applicationId String fromStatus ApplicationStatus? toStatus ApplicationStatus reason String? createdAt DateTime @default(now()) application Application @relation(fields:[applicationId],references:[id]) }
model Answer { id String @id @default(cuid()) userId String question String answer String category String verified Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id]) }
model Resume { id String @id @default(cuid()) userId String originalName String storageKey String mimeType String size Int extractedText String? approvedAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) }
